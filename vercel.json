{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["fra1"],
  "services": {
    "web": {
      "root": "web/",
      "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
    },
    "api": {
      "root": "api/",
      "entrypoint": "main:app",
      "buildCommand": "python -m scripts.migrate",
      "functions": {
        "main.py": {
          "maxDuration": 60,
          "excludeFiles": "{tests/**,venv/**,alembic/versions/__pycache__/**,*.db}"
        }
      },
      "routes": [
        {
          "src": "/api/(.*)",
          "transforms": [
            { "type": "request.path", "op": "set", "args": "/$1" }
          ]
        }
      ]
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
