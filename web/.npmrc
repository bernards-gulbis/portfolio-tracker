# openapi-typescript@7.x still pins its peer to typescript@^5.x, but the rest
# of the toolchain (typescript-eslint, react-day-picker, etc.) already supports
# TS 6 and the project pins typescript@~6.0.3. Tolerate the lone peer mismatch
# so `npm ci` succeeds in CI without `--legacy-peer-deps` on the command line.
# Remove this file once openapi-typescript widens its peer range to include TS 6.
legacy-peer-deps=true
