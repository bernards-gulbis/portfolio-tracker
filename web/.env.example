# Environment variables
#
# The API is served same-origin under /api and needs no configuration:
# locally the Vite dev proxy forwards /api to http://localhost:8000, and in
# production Vercel routes /api to the api service. Leave this unset unless
# you are pointing the frontend at a backend on another origin — in which case
# the backend also needs that origin in CORS_ORIGINS and COOKIE_SAMESITE=none.
#
# VITE_API_BASE_URL=http://localhost:8000
