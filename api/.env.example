# Database Configuration
# For local development (default): SQLite
# DATABASE_URL=sqlite:///./portfolio_tracker.db
#
# For production (Neon PostgreSQL):
# Replace <password> with your actual Neon database password
# DATABASE_URL=postgresql://neondb_owner:<password>@ep-snowy-mode-a912igqt-pooler.gwc.azure.neon.tech/neondb?sslmode=require

# DATABASE_URL is mandatory once COOKIE_SECURE=true: a production deployment
# that fell back to the SQLite default would work, then lose its data on the
# next restart. Config refuses to start in that combination.

# PostgreSQL Connection Pool Settings (only applies when using PostgreSQL)
# Each running instance holds up to DB_POOL_SIZE + DB_MAX_OVERFLOW connections.
# Lower both on hosts that scale horizontally (2/3 is a reasonable start) —
# the pool multiplies by the number of live instances.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10

# Apply Alembic migrations when the app starts. Correct for local dev and e2e,
# where the app owns its database. Set false wherever the app scales beyond one
# process — otherwise every cold start issues DDL, unlocked, and concurrent
# starts race. Those deployments run `python -m scripts.migrate` at build time.
# RUN_MIGRATIONS_ON_STARTUP=true

# Set to 'true' to enable SQL query logging (useful for development/debugging)
# WARNING: Do not enable in production as it logs all SQL queries
DATABASE_ECHO=false

# CORS Configuration (comma-separated list)
# Add your frontend URLs here. These origins will be allowed to access the API.
# Default: http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# LOG_LEVEL=INFO

# Price Cache TTL in seconds (default: 55, synced with frontend 60s polling)
# PRICE_CACHE_TTL_SECONDS=55

# ================== Authentication ==================
# Generate secrets with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE-ME
OAUTH_STATE_SECRET=CHANGE-ME

# Google OAuth2 (optional — leave empty to disable Google login)
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create OAuth 2.0 Client ID (Web application)
# 3. Authorized JavaScript origins: http://localhost:3000
# 4. Authorized redirect URIs: http://localhost:8000/auth/google/callback
#    (Google sends the browser here; backend exchanges the code, sets the
#     cookie, then redirects the browser to FRONTEND_URL)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Frontend origin — where the backend sends the browser after a successful
# OAuth login, and where OAuth errors are reported
FRONTEND_URL=http://localhost:3000

# Absolute callback URL handed to Google. Leave empty to derive it from the
# incoming request, which is right when the API is reached at its own root.
# Set it when a proxy strips a path prefix before the app sees the request —
# the app cannot reconstruct its public URL, and a wrong redirect_uri fails the
# token exchange. Must match an Authorized redirect URI in Google Console.
# OAUTH_REDIRECT_URL=https://your-app.vercel.app/api/auth/google/callback

# Public path prefix the API is mounted under, when a proxy strips it before
# routing. Only affects generated URLs (/docs, the OpenAPI servers entry).
# API_ROOT_PATH=/api

# Set to true in production (requires HTTPS)
COOKIE_SECURE=false

# Cookie SameSite attribute (lax, strict, none)
# "lax" is correct when the frontend and API share an origin — the default now
# that both are served from one Vercel deployment. Only use "none" if you split
# them across domains; COOKIE_SECURE must then be true, and the frontend origin
# must appear in CORS_ORIGINS.
# COOKIE_SAMESITE=lax

# Set to true to bypass all auth rate limits. Used by the Playwright e2e run
# (see web/playwright.config.ts); never set this in a deployed environment.
# DISABLE_RATE_LIMIT=false
