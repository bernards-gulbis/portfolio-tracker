# Database Configuration
# Set to 'true' to enable SQL query logging (useful for development/debugging)
# WARNING: Do not enable in production as it logs all SQL queries
DATABASE_ECHO=false

# CORS Configuration (comma-separated list)
# Add your frontend URLs here
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# LOG_LEVEL=INFO

# Price Cache TTL in minutes (default: 15)
# PRICE_CACHE_TTL=15
